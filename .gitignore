# Dependencies and local caches
node_modules/
.npm/
.cache/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Development builds and generated test data
/.test-build/
/dev-dist/
/.playwright-cli/
/evidence/fixtures/
/coverage/
/playwright-report/
/test-results/
/output/releases/

# Evidence keeps compact reports and asset provenance, not every run artifact.
/evidence/**
!/evidence/**/
!/evidence/**/*.md
!/evidence/**/*.json
!/evidence/**/*.py
!/evidence/asset-audit/**
/evidence/**/__pycache__/
/evidence/**/*.py[cod]
/evidence/fixtures/
/evidence/**/browser-export.json
/evidence/**/state.json

# Local experiments and independent project copies
/scratch/
/revisions/

# Local environment; keep a shareable configuration example
.env
.env.*
!.env.example

# Package-manager diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor temporary files and OS metadata
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# dist/, public/assets/ and output/assets/ are project deliverables.
# Evidence uses the selective policy above; local release ZIPs are reproducible.

# Private optional snapshot service data
/output/cloud-snapshots/
